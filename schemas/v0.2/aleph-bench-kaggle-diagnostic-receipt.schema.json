{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aleph-Bench Kaggle Deployment Diagnostic Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptVersion",
    "artifactKind",
    "targetProtocolVersion",
    "evidenceMode",
    "protocolConformant",
    "leaderboardEligible",
    "publicationEligible",
    "status",
    "phase",
    "startedAt",
    "endedAt",
    "taskIdentity",
    "runtime",
    "dependency",
    "modelIdentity",
    "policy",
    "calls",
    "rows",
    "diagnostics",
    "diagnosticScalar",
    "notes",
    "id"
  ],
  "properties": {
    "receiptVersion": { "const": "0.2.0" },
    "artifactKind": { "const": "kaggle_runtime_canary" },
    "targetProtocolVersion": { "const": "0.2.0" },
    "evidenceMode": { "const": "none" },
    "protocolConformant": { "const": false },
    "leaderboardEligible": { "const": false },
    "publicationEligible": { "const": false },
    "status": { "enum": ["blocked", "complete"] },
    "phase": {
      "enum": [
        "runtime_preflight",
        "package_preflight",
        "model_preflight",
        "model_calls",
        "complete"
      ]
    },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "endedAt": { "$ref": "#/$defs/timestamp" },
    "taskIdentity": { "$ref": "#/$defs/taskIdentity" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "dependency": { "$ref": "#/$defs/dependency" },
    "modelIdentity": { "$ref": "#/$defs/modelIdentity" },
    "policy": { "$ref": "#/$defs/policy" },
    "calls": { "$ref": "#/$defs/calls" },
    "rows": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/row" }
    },
    "diagnostics": { "$ref": "#/$defs/diagnostics" },
    "diagnosticScalar": { "type": "null" },
    "notes": {
      "const": [
        "This receipt is a deployment canary, not an Aleph-Bench result.",
        "It cannot establish AURC, ECL, Elicit, model rank, or shortest-found claims.",
        "A complete canary proves only this fixed six-call transport and capture path.",
        "Never attach this task to the Aleph-Bench v0.2 leaderboard."
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^aleph-bench-kaggle-diagnostic-v0\\.2-artifact-[0-9a-f]{64}$"
    }
  },
  "if": {
    "type": "object",
    "properties": { "status": { "const": "complete" } }
  },
  "then": {
    "type": "object",
    "properties": {
      "phase": { "const": "complete" },
      "runtime": {
        "type": "object",
        "properties": { "conformant": { "const": true } }
      },
      "dependency": {
        "type": "object",
        "properties": {
          "observed": {
            "type": "object",
            "properties": { "status": { "const": "verified" } }
          }
        }
      },
      "modelIdentity": {
        "type": "object",
        "properties": {
          "status": { "const": "observed" },
          "slug": { "type": "string", "minLength": 1 },
          "pythonType": { "type": "string", "minLength": 1 },
          "transportSdkName": { "enum": ["openai", "google-genai"] },
          "transportMaxAttempts": { "const": 1 },
          "outputTokenParameter": {
            "enum": ["max_tokens", "max_output_tokens"]
          }
        }
      },
      "calls": {
        "type": "object",
        "properties": {
          "planned": { "const": 6 },
          "attempted": { "const": 6 },
          "completed": { "const": 6 },
          "activeCall": { "type": "null" }
        }
      },
      "rows": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "items": {
          "type": "object",
          "properties": {
            "outputType": { "const": "str" },
            "outputText": { "type": "string", "minLength": 1 },
            "outputOmittedReason": { "type": "null" },
            "usage": {
              "type": "object",
              "properties": {
                "inputTokens": { "type": "integer", "minimum": 1 },
                "outputTokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2043
                }
              }
            }
          }
        }
      },
      "diagnostics": {
        "type": "object",
        "properties": {
          "blockedReasons": { "const": [] },
          "emptyPromptIds": { "const": [] },
          "invalidUsagePromptIds": { "const": [] },
          "nearCapPromptIds": { "const": [] },
          "failure": { "type": "null" }
        }
      }
    }
  },
  "else": {
    "type": "object",
    "properties": {
      "phase": {
        "enum": [
          "runtime_preflight",
          "package_preflight",
          "model_preflight",
          "model_calls"
        ]
      },
      "diagnostics": {
        "type": "object",
        "properties": {
          "blockedReasons": { "type": "array", "minItems": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "phase": { "enum": ["model_calls", "complete"] }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "modelIdentity": {
            "type": "object",
            "properties": { "transportMaxAttempts": { "const": 1 } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "nullableString": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "nullableNonnegativeInteger": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "nullableNanodollars": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]+$" },
        { "type": "null" }
      ]
    },
    "packageIdentity": {
      "const": {
        "checksums": {
          "bytes": 764,
          "path": "checksums.sha256",
          "sha256": "58bda3626fc21a0071ddeb89c97438b61f991bcf52bb5222b37e951a52f9e1d0"
        },
        "datasetId": "aleph-bench-v0.2-public-s2",
        "datasetItemCount": 30,
        "datasetSha256": "6f3a03400ec16405414afb94c7c639f2df07f7f0797c3b58ad1c4229e52f2041",
        "id": "aleph-bench-v0.2-scorer-conformance",
        "items": {
          "bytes": 89395,
          "path": "data/public_s2_items.jsonl",
          "sha256": "53334e3e0394631ec128d7c7d2bd364ad0bc7d44b030c66cb3cc91b432e04747"
        },
        "manifest": {
          "bytes": 3427,
          "path": "package-manifest.json",
          "sha256": "7a7aad7ae4f3fcc0bebb23cb3f3d11abe842385cc8b94e9c56a806c3c7d6089d"
        },
        "packageVersion": "0.2.0",
        "protocolVersion": "0.2.0",
        "scoringCore": {
          "bytes": 16621,
          "path": "kaggle/_scoring.py",
          "sha256": "bf38b1ac35bc1cdb99fb59f26de5d0e6ac953ca7f29a07a2b90e7cf3b028dd01"
        }
      }
    },
    "taskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "description",
        "definitionSha256",
        "implementationSha256"
      ],
      "properties": {
        "name": { "const": "aleph_bench_deployment_diagnostic_2048_none" },
        "version": { "const": 1 },
        "description": {
          "const": "Diagnose Aleph-Bench v0.2 Kaggle runtime, package, model transport, and usage capture with a fixed six-call canary."
        },
        "definitionSha256": {
          "const": "b2125f85062a34b39de54e7c38889434a8063d8d9ddb3ff6bd3f5780a67b4fe9"
        },
        "implementationSha256": {
          "const": "ca9b0baac025062a7513b1162715062242efe40591af63ef0a43ce1f0872d51f"
        }
      }
    },
    "runtimeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pythonVersion", "pythonFullVersion", "unicodeDatabaseVersion"],
      "properties": {
        "pythonVersion": { "type": "string", "minLength": 1 },
        "pythonFullVersion": { "type": "string", "minLength": 1 },
        "unicodeDatabaseVersion": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "observed", "conformant"],
      "properties": {
        "required": {
          "const": {
            "pythonVersion": "3.13",
            "unicodeDatabaseVersion": "15.1.0"
          }
        },
        "observed": { "$ref": "#/$defs/runtimeObservation" },
        "conformant": { "type": "boolean" }
      }
    },
    "dependencyObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mountPath",
        "manifestSha256",
        "itemsSha256",
        "scoringCoreSha256"
      ],
      "properties": {
        "status": { "enum": ["unchecked", "blocked", "verified"] },
        "mountPath": { "type": "string", "minLength": 1 },
        "manifestSha256": { "$ref": "#/$defs/nullableSha256" },
        "itemsSha256": { "$ref": "#/$defs/nullableSha256" },
        "scoringCoreSha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed"],
      "properties": {
        "expected": { "$ref": "#/$defs/packageIdentity" },
        "observed": { "$ref": "#/$defs/dependencyObservation" }
      }
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "slug",
        "pythonType",
        "sdkVersion",
        "outputTokenParameter",
        "transportSdkName",
        "transportSdkVersion",
        "transportMaxAttempts"
      ],
      "properties": {
        "status": { "enum": ["unavailable", "observed"] },
        "slug": { "$ref": "#/$defs/nullableString" },
        "pythonType": { "$ref": "#/$defs/nullableString" },
        "sdkVersion": { "$ref": "#/$defs/nullableString" },
        "transportSdkName": {
          "anyOf": [
            { "enum": ["openai", "google-genai"] },
            { "type": "null" }
          ]
        },
        "transportSdkVersion": { "$ref": "#/$defs/nullableString" },
        "transportMaxAttempts": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "outputTokenParameter": {
          "anyOf": [
            { "enum": ["max_tokens", "max_output_tokens"] },
            { "type": "null" }
          ]
        }
      }
    },
    "policy": {
      "const": {
        "conversationIsolation": "one_named_chat_per_prompt",
        "maxOutputTokensRequested": 2048,
        "maxTotalOutputTokens": 12288,
        "nearCapMarginTokens": 4,
        "outputTokenParameterByTransport": {
          "kaggle_benchmarks.actors.llms.GoogleGenAI": "max_output_tokens",
          "kaggle_benchmarks.actors.llms.OpenAI": "max_tokens"
        },
        "promptIds": [
          "s2-001-r1-p0",
          "s2-001-r1-p1",
          "s2-002-r1-p0",
          "s2-002-r1-p1",
          "s2-003-r1-p0",
          "s2-003-r1-p1"
        ],
        "reasoningRequested": "none",
        "retries": 0,
        "sampleCount": 6,
        "sdkCall": "llm.prompt",
        "seedRequested": 0,
        "temperatureRequested": 0,
        "transportMaxAttempts": 1
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "inputCostNanodollars",
        "outputCostNanodollars",
        "totalBackendLatencyMs"
      ],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "inputCostNanodollars": { "$ref": "#/$defs/nullableNanodollars" },
        "outputCostNanodollars": { "$ref": "#/$defs/nullableNanodollars" },
        "totalBackendLatencyMs": { "$ref": "#/$defs/nullableNonnegativeInteger" }
      }
    },
    "aggregateUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "inputCostNanodollars",
        "outputCostNanodollars",
        "totalBackendLatencyMs"
      ],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "inputCostNanodollars": { "$ref": "#/$defs/nullableNanodollars" },
        "outputCostNanodollars": { "$ref": "#/$defs/nullableNanodollars" },
        "totalBackendLatencyMs": { "$ref": "#/$defs/nullableNonnegativeInteger" }
      }
    },
    "calls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned",
        "attempted",
        "completed",
        "activeCall",
        "aggregateUsage"
      ],
      "properties": {
        "planned": { "const": 6 },
        "attempted": { "type": "integer", "minimum": 0, "maximum": 6 },
        "completed": { "type": "integer", "minimum": 0, "maximum": 6 },
        "activeCall": {
          "anyOf": [
            { "$ref": "#/$defs/activeCall" },
            { "type": "null" }
          ]
        },
        "aggregateUsage": { "$ref": "#/$defs/aggregateUsage" }
      }
    },
    "activeCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptId", "conversationName", "state"],
      "properties": {
        "promptId": {
          "enum": [
            "s2-001-r1-p0",
            "s2-001-r1-p1",
            "s2-002-r1-p0",
            "s2-002-r1-p1",
            "s2-003-r1-p0",
            "s2-003-r1-p1"
          ]
        },
        "conversationName": {
          "pattern": "^s2-00[1-3]:s2-00[1-3]-r1-p[01]$",
          "type": "string"
        },
        "state": { "enum": ["prepared", "dispatching", "returned"] }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "promptId",
        "conversationName",
        "promptSha256",
        "outputType",
        "outputText",
        "outputSha256",
        "outputCharacters",
        "outputOmittedReason",
        "usage"
      ],
      "properties": {
        "itemId": { "enum": ["s2-001", "s2-002", "s2-003"] },
        "promptId": {
          "enum": [
            "s2-001-r1-p0",
            "s2-001-r1-p1",
            "s2-002-r1-p0",
            "s2-002-r1-p1",
            "s2-003-r1-p0",
            "s2-003-r1-p1"
          ]
        },
        "conversationName": { "type": "string", "minLength": 1 },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "outputType": { "type": "string", "minLength": 1 },
        "outputText": {
          "anyOf": [
            { "type": "string", "maxLength": 65536 },
            { "type": "null" }
          ]
        },
        "outputSha256": { "$ref": "#/$defs/nullableSha256" },
        "outputCharacters": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "outputOmittedReason": {
          "anyOf": [
            { "enum": ["non_string", "character_limit"] },
            { "type": "null" }
          ]
        },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptId", "exceptionType", "message"],
      "properties": {
        "promptId": {
          "anyOf": [
            {
              "enum": [
                "s2-001-r1-p0",
                "s2-001-r1-p1",
                "s2-002-r1-p0",
                "s2-002-r1-p1",
                "s2-003-r1-p0",
                "s2-003-r1-p1"
              ]
            },
            { "type": "null" }
          ]
        },
        "exceptionType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockedReasons",
        "emptyPromptIds",
        "invalidUsagePromptIds",
        "nearCapPromptIds",
        "failure"
      ],
      "properties": {
        "blockedReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "canary_incomplete",
              "chat_close_failed",
              "chat_open_failed",
              "empty_output",
              "invalid_usage",
              "model_call_failed",
              "model_identity_unavailable",
              "near_output_cap",
              "non_string_output",
              "output_character_limit",
              "package_unavailable_or_drifted",
              "runtime_mismatch",
              "sdk_api_incompatible",
              "transport_retry_policy_unverified",
              "unsupported_model_transport"
            ]
          }
        },
        "emptyPromptIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "invalidUsagePromptIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "nearCapPromptIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "failure": {
          "anyOf": [
            { "$ref": "#/$defs/failure" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "stratum",
    "language",
    "target",
    "metricClass",
    "frozenLadder",
    "canaryGuid",
    "provenance",
    "license"
  ],
  "properties": {
    "id": { "type": "string" },
    "stratum": { "enum": ["S1", "S2", "S3", "S4"] },
    "language": { "type": "string" },
    "target": { "$ref": "#/$defs/target" },
    "metricClass": { "enum": ["exact", "lexical", "semantic", "judge", "execution"] },
    "frozenLadder": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/frozenLadderPrompt" }
    },
    "canaryGuid": { "type": "string" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "generatedAt", "method", "seed"],
      "properties": {
        "createdBy": { "type": "string" },
        "generatedAt": { "type": "string" },
        "method": { "type": "string" },
        "seed": { "type": "integer" },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } },
              { "type": "array", "items": { "type": "number" } }
            ]
          }
        }
      }
    },
    "license": { "type": "string" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "frozenLadderPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rung", "paraphrase", "label", "prompt"],
      "properties": {
        "id": { "type": "string" },
        "rung": { "enum": [0, 1, 2, 3] },
        "paraphrase": { "enum": [0, 1] },
        "label": { "type": "string" },
        "prompt": { "type": "string" },
        "expectedLeakage": { "enum": ["leaky_anchor", "non_leaking_candidate"] }
      }
    }
  }
}

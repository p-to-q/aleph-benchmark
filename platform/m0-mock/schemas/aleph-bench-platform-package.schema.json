{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchPlatformPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "createdAt",
    "packageKind",
    "evidenceMode",
    "root",
    "targetPlatforms",
    "kaggleDatasetId",
    "huggingFaceDatasetId",
    "artifacts",
    "validationCommands",
    "notes"
  ],
  "properties": {
    "id": { "type": "string" },
    "createdAt": { "type": "string" },
    "packageKind": { "enum": ["platform_release"] },
    "evidenceMode": { "enum": ["fixture", "mock", "black_box", "white_box", "simulated", "none"] },
    "root": { "type": "string" },
    "targetPlatforms": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["huggingface_dataset", "kaggle_dataset", "kaggle_community_benchmark", "croissant"] }
    },
    "kaggleDatasetId": { "type": "string" },
    "huggingFaceDatasetId": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "validationCommands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes", "encodingFormat", "note"],
      "properties": {
        "role": { "enum": ["data", "docs", "evidence", "huggingface", "kaggle", "metadata", "schemas"] },
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "encodingFormat": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
